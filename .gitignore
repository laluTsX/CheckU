# ==============================================================================
# CHECKU - MASTER .GITIGNORE (Root Monorepo)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencias y Paquetes de Node.js (Web, Movil, MovilExpo)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ------------------------------------------------------------------------------
# 2. Entornos Virtuales y Cache de Python (BackEnd)
# ------------------------------------------------------------------------------
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
ENV/
**/ENV/

# Archivos compilados de Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Bases de datos temporales / locales
*.sqlite3
*.db
BackEnd/instance/

# Cache de pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/
.tox/

# ------------------------------------------------------------------------------
# 3. Next.js y Frontend Web (web/)
# ------------------------------------------------------------------------------
web/.next/
**/.next/
web/out/
**/out/
web/dist/
web/build/
*.tsbuildinfo
web/tsconfig.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. React Native & Expo (Movil & MovilExpo)
# ------------------------------------------------------------------------------
# Expo
.expo/
**/.expo/
web-build/
**/web-build/
expo-env.d.ts

# Android Nativo (Movil/)
**/android/.gradle/
**/android/app/build/
**/android/build/
**/android/.cxx/
**/android/local.properties
*.apk
*.aab
*.keystore
!debug.keystore

# iOS Nativo (Movil/)
**/ios/Pods/
**/ios/build/
**/ios/DerivedData/
**/ios/*.xcworkspace/xcuserdata/
**/ios/*.xcodeproj/xcuserdata/
*.ipa

# Metro Bundler
.metro-health-check*
*.jsbundle

# ------------------------------------------------------------------------------
# 5. Archivos Sensibles y Variables de Entorno (Credenciales)
# ------------------------------------------------------------------------------
# Archivos .env con credenciales reales
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env*.local

# Permitir explícitamente plantillas de ejemplo
!.env.example
!**/.env.example

# ------------------------------------------------------------------------------
# 6. Almacenamiento de Archivos de Usuarios (Uploads / Justificantes)
# ------------------------------------------------------------------------------
# Ignorar justificantes médicos y comprobantes reales subidos por alumnos
BackEnd/uploads/*
!BackEnd/uploads/.gitkeep
BackEnd/uploads/justificantes/*
!BackEnd/uploads/justificantes/.gitkeep

# ------------------------------------------------------------------------------
# 7. Editores de Código e IDEs
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
**/.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 8. Sistema Operativo (Windows & macOS)
# ------------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*

# ------------------------------------------------------------------------------
# 9. Logs y Archivos Temporales
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/
*.tmp
*.temp
.temp/
.tmp/
